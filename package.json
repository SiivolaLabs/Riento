{
  "name": "mesta",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "admin:delete-review-account": "tsx scripts/deleteReviewAccountByEmail.ts",
    "admin:export-user-data": "tsx scripts/exportUserDataRequest.ts",
    "admin:moderate-review": "tsx scripts/moderateVenueReview.ts",
    "admin:resolve-venue-report": "tsx scripts/resolveVenueReport.ts",
    "admin:set-now-playing": "tsx scripts/setVenueNowPlaying.ts",
    "audit:venues:osm": "tsx scripts/auditVenueOsm.ts",
    "eas-build-pre-install": "node scripts/fetchAcrCloudAndroidSdk.mjs",
    "fetch:acrcloud-android-sdk": "node scripts/fetchAcrCloudAndroidSdk.mjs",
    "hosting:deploy:prod": "npm run hosting:export && npx eas-cli deploy --prod --export-dir dist",
    "hosting:export": "npm run legal:pages:sync && expo export --platform web --clear",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "legal:pages:check": "tsx scripts/writeHostedLegalPages.ts --check",
    "legal:pages:check-live": "tsx scripts/writeHostedLegalPages.ts --check-live",
    "legal:pages:sync": "tsx scripts/writeHostedLegalPages.ts",
    "loadtest:reads": "tsx scripts/loadTestLaunchReads.ts",
    "ops:backup": "bash scripts/backupSupabase.sh",
    "ops:queues": "tsx scripts/checkLaunchQueues.ts",
    "postinstall": "node scripts/patchGoogleSignInIosNonce.mjs",
    "setup:supabase:sql": "npm run seed:venues:sql && tsx scripts/writeSupabaseSetupSql.ts",
    "seed:venues:sql": "tsx scripts/writeVenueSeedSql.ts",
    "verify": "npm run typecheck && npm run legal:pages:check && npm run seed:venues:check && npm run verify:supabase:sql && npm run verify:launch:source && npx expo-doctor",
    "seed:venues:check": "tsx scripts/writeVenueSeedSql.ts --check",
    "verify:supabase:sql": "tsx scripts/writeSupabaseSetupSql.ts --check",
    "verify:launch:source": "tsx scripts/verifyLaunchSource.ts",
    "verify:launch:live": "tsx scripts/verifyLaunchReadiness.ts",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "opening_hours": "^3.14.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  }
}
